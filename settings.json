{
  "breadcrumbs.symbolPath": "off",
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.extensionTools.enabled": false,
  "chat.mcp.access": "none",
  "chat.useCloudButtonV2": false,
  "dev.containers.copyGitConfig": false, // Valid even if greyed out. See: https://github.com/microsoft/vscode-remote-release/issues/5500
  "dev.containers.cacheVolume": true,
  "dev.containers.experimentalLockfile": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.autoClosingDelete": "always",
  "editor.bracketPairColorization.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.fontSize": 14,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlineSuggest.enabled": false,
  "editor.lightbulb.enabled": "off",
  "editor.links": false,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.parameterHints.enabled": false,
  "editor.quickSuggestions": { "other": "off" },
  "editor.quickSuggestionsDelay": 250,
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.stickyScroll.enabled": false,
  "editor.suggest.showSnippets": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.tabCompletion": "on",
  "explorer.autoRevealExclude": {
    "**/bower_components": false,
    "**/node_modules": false
  },
  "extensions.autoUpdate": false,
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": true,
  "git.blame.editorDecoration.enabled": false,
  "gitlens.blame.avatars": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.telemetry.enabled": false,
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "inlineChat.enableV2": true,
  "inlineChat.lineNaturalLanguageHint": false,
  "problems.visibility": false,
  "redhat.telemetry.enabled": false,
  "scm.diffDecorations": "gutter",
  "search.smartCase": true,
  "security.workspace.trust.untrustedFiles": "open",
  "tailwindCSS.colorDecorators": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontSize": 14,
  "vim.showMarksInGutter": true,
  "vim.sneak": true,
  "vim.surround": true,
  "vim.useSystemClipboard": true,
  "vim.commandLineModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-h>"],
      "after": ["<Left>"]
    },
    {
      "before": ["<C-j>"],
      "after": ["<Down>"]
    },
    {
      "before": ["<C-k>"],
      "after": ["<Up>"]
    },
    {
      "before": ["<C-l>"],
      "after": ["<Right>"]
    }
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-h>"],
      "after": ["<Left>"]
    },
    {
      "before": ["<C-j>"],
      "after": ["<Down>"]
    },
    {
      "before": ["<C-k>"],
      "after": ["<Up>"]
    },
    {
      "before": ["<C-l>"],
      "after": ["<Right>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Go To Actions
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"],
      "silent": "true"
    },
    {
      "before": ["g", "e"],
      "commands": ["editor.action.marker.next"],
      "silent": "true"
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showHover"],
      "silent": "true"
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
      "silent": "true"
    },
    {
      "before": ["g", "p"],
      "commands": ["editor.action.peekDefinition"],
      "silent": "true"
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
      "silent": "true"
    },
    {
      "before": ["g", "s"],
      "commands": ["typescript.goToSourceDefinition"],
      "silent": "true"
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToTypeDefinition"],
      "silent": "true"
    },
    {
      "before": ["g", "s"],
      "commands": ["typescript.goToSourceDefinition"],
      "silent": "true"
    },
    // Leader Actions
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "d"],
      "commands": ["workbench.action.debug.start"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["editor.action.formatDocument"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "k"],
      "commands": ["workbench.action.debug.stop"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "l"],
      "commands": ["editor.debug.action.toggleBreakpoint"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.action.debug.continue"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "r"],
      "commands": ["editor.action.rename"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "s"],
      "commands": ["workbench.action.debug.run"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "t", "g"],
      "commands": ["go.toggle.test.file"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "x"],
      "commands": ["editor.action.refactor"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "<leader>"],
      "commands": ["editor.action.showContextMenu"],
      "silent": "true"
    },
    {
      "before": ["<leader>", "<CR>"],
      "commands": ["editor.action.quickFix"],
      "silent": "true"
    },
    // Other Keybindings
    {
      "before": ["d"],
      "after": ["\"", "_", "d"]
    },
    {
      "before": ["r"],
      "after": ["\"", "_", "r"]
    },
    {
      "before": ["<Space>"],
      "after": ["-"]
    },
    // Workaround: https://github.com/VSCodeVim/Vim/issues/2007
    {
      "before": ["u"],
      "commands": ["undo"],
      "silent": true
    },
    {
      "before": ["<C-r>"],
      "commands": ["redo"],
      "silent": true
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"],
      "silent": "true"
    },
    {
      "before": ["d"],
      "after": ["\"", "_", "d"]
    },
    {
      "before": ["p"],
      "after": ["P"]
    },
    {
      "before": ["r"],
      "after": ["\"", "_", "r"]
    },
    // Set cursor position at the last character of the yanked selction
    // See: https://stackoverflow.com/a/38983784/5384400
    {
      "before": ["y"],
      "after": ["y", "`", ">"]
    }
  ],
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.title": "${activeEditorShort}${separator}${rootNameShort}${separator}${profileName}",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "[Default Dark Modern][Default Light Modern]": {
      "editor.symbolHighlightBackground": "#0000",
      "editor.symbolHighlightBorder": "#0000"
    }
  },
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "yaml.schemas": {
    "/home/vscode/.vscode-server/extensions/continue.continue-1.0.21-linux-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  }
}
