{
  "chat.agent.enabled": true,
  "dev.containers.cacheVolume": true,
  "dev.containers.experimentalLockfile": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.autoClosingDelete": "always",
  "editor.cursorBlinking": "solid",
  "editor.fontSize": 14,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.lightbulb.enabled": "off",
  "editor.lineNumbers": "relative",
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.quickSuggestionsDelay": 250,
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.stickyScroll.enabled": false,
  "editor.suggest.showSnippets": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": true,
  "git.blame.editorDecoration.enabled": false,
  "gitlens.blame.avatars": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.telemetry.enabled": false,
  "inlineChat.lineNaturalLanguageHint": false,
  "redhat.telemetry.enabled": false,
  "scm.diffDecorations": "gutter",
  "search.smartCase": true,
  "security.workspace.trust.untrustedFiles": "open",
  "tailwindCSS.colorDecorators": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.showStatusBar": false,
  "vscode-neovim.neovimExecutablePaths.darwin": "/usr/local/nvim/bin/nvim",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.title": "${activeEditorShort}${separator}${rootNameShort}${separator}${profileName}",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "[Default Dark Modern][Default Light Modern]": {
      "editor.symbolHighlightBackground": "#0000",
      "editor.symbolHighlightBorder": "#0000"
    }
  },
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.view.showQuietly": {
    "workbench.panel.output": true
  }
}
