{
  "breadcrumbs.symbolPath": "off",
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.extensionTools.enabled": false,
  "chat.mcp.access": "none",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.autoClosingDelete": "always",
  "editor.bracketPairColorization.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.fontSize": 14,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.hover.enabled": "off",
  "editor.lightbulb.enabled": "off",
  "editor.links": false,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.parameterHints.enabled": false,
  "editor.quickSuggestions": { "other": "off" },
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.selectionHighlight": false,
  "editor.showFoldingControls": "never",
  "editor.stickyScroll.enabled": false,
  "editor.suggest.showSnippets": false,
  "editor.suggest.showWords": false,
  "explorer.autoRevealExclude": {
    "**/bower_components": false,
    "**/node_modules": false,
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.go": "${capture}_test.go",
  },
  "extensions.autoUpdate": false,
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
  },
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": true,
  "git.blame.editorDecoration.enabled": false,
  "git.decorations.enabled": false,
  "go.coverOnSingleTest": true,
  "go.coverOnSingleTestFile": true,
  "go.coverOnTestPackage": true,
  "gopls": {
    "ui.completion.completeFunctionCalls": false,
    "ui.completion.matcher": "CaseSensitive",
  },
  "redhat.telemetry.enabled": false,
  "scm.diffDecorations": "none",
  "search.smartCase": true,
  "search.useParentIgnoreFiles": true,
  "security.workspace.trust.untrustedFiles": "open",
  "tailwindCSS.colorDecorators": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontSize": 14,
  "vim.showMarksInGutter": true,
  "vim.showmodename": false,
  "vim.sneak": true,
  "vim.surround": true,
  "vim.commandLineModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-h>"],
      "after": ["<Left>"],
    },
    {
      "before": ["<C-j>"],
      "after": ["<Down>"],
    },
    {
      "before": ["<C-k>"],
      "after": ["<Up>"],
    },
    {
      "before": ["<C-l>"],
      "after": ["<Right>"],
    },
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-h>"],
      "after": ["<Left>"],
    },
    {
      "before": ["<C-j>"],
      "after": ["<Down>"],
    },
    {
      "before": ["<C-k>"],
      "after": ["<Up>"],
    },
    {
      "before": ["<C-l>"],
      "after": ["<Right>"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Go To Actions
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"],
      "silent": "true",
    },
    {
      "before": ["g", "e"],
      "commands": ["editor.action.marker.next"],
      "silent": "true",
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showHover"],
      "silent": "true",
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
      "silent": "true",
    },
    {
      "before": ["g", "p"],
      "commands": ["editor.action.peekDefinition"],
      "silent": "true",
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
      "silent": "true",
    },
    {
      "before": ["g", "s"],
      "commands": ["typescript.goToSourceDefinition"],
      "silent": "true",
    },
    {
      "before": ["g", "t"],
      "commands": ["editor.action.goToTypeDefinition"],
      "silent": "true",
    },
    {
      "before": ["g", "s"],
      "commands": ["typescript.goToSourceDefinition"],
      "silent": "true",
    },
    // Leader Actions
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "d"],
      "commands": ["workbench.action.debug.start"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["editor.action.formatDocument"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "k"],
      "commands": ["workbench.action.debug.stop"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "l"],
      "commands": ["editor.debug.action.toggleBreakpoint"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "m"],
      "commands": ["git.blame.toggleEditorDecoration"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.action.debug.continue"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "r"],
      "commands": ["editor.action.rename"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "s"],
      "commands": ["workbench.action.debug.run"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "t", "g"],
      "commands": ["go.toggle.test.file"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "x"],
      "commands": ["editor.action.refactor"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "<leader>"],
      "commands": ["editor.action.showContextMenu"],
      "silent": "true",
    },
    {
      "before": ["<leader>", "<CR>"],
      "commands": ["editor.action.quickFix"],
      "silent": "true",
    },
    // Other Keybindings
    {
      "before": ["d"],
      "after": ["\"", "_", "d"],
    },
    {
      "before": ["r"],
      "after": ["\"", "_", "r"],
    },
    {
      "before": ["<Space>"],
      "after": ["-"],
    },
    // Workaround: https://github.com/VSCodeVim/Vim/issues/2007
    {
      "before": ["u"],
      "commands": ["undo"],
      "silent": true,
    },
    {
      "before": ["<C-r>"],
      "commands": ["redo"],
      "silent": true,
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"],
      "silent": "true",
    },
    {
      "before": ["d"],
      "after": ["\"", "_", "d"],
    },
    {
      "before": ["p"],
      "after": ["P"],
    },
    {
      "before": ["r"],
      "after": ["\"", "_", "r"],
    },
    // Set cursor position at the last character of the yanked selction
    // See: https://stackoverflow.com/a/38983784/5384400
    {
      "before": ["y"],
      "after": ["y", "`", ">"],
    },
  ],
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.title": "${activeEditorShort}${separator}${rootNameShort}${separator}${profileName}",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "[Dark 2026][Light 2026]": {
      "editor.symbolHighlightBackground": "#0000",
      "editor.symbolHighlightBorder": "#0000",
      "editorLineNumber.activeForeground": "#6E7681",
    },
    "[Dark 2026]": {
      "statusBarItem.remoteBackground": "#181818",
      "statusBarItem.warningBackground": "#181818",
    },
    "[Light 2026]": {
      "statusBarItem.remoteBackground": "#f8f8f8",
      "statusBarItem.remoteForeground": "#3b3b3b",
      "statusBarItem.warningBackground": "#f8f8f8",
      "statusBarItem.warningForeground": "#3b3b3b",
    },
  },
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.tree.renderIndentGuides": "none",
}
