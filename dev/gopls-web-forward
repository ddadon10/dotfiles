#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: gopls-web-forward <gopls-url>" >&2
    exit 2
}

[[ "$#" -eq 1 ]] || usage

url="$1"
listen_port=8081
pid_file="/tmp/gopls-web-forward.pid"
log_file="/tmp/gopls-web-forward.log"
nginx_file="/tmp/gopls-web-forward.nginx.conf"

case "$url" in
    http://127.0.0.1:*/* | http://localhost:*/*) ;;
    *) usage ;;
esac

without_scheme="${url#http://}"
host_port="${without_scheme%%/*}"
path="/${without_scheme#*/}"
target_port="${host_port##*:}"

if [[ ! "$target_port" =~ ^[0-9]+$ ]]; then
    usage
fi

if [[ "$path" != /gopls/* ]]; then
    usage
fi

if ! nginx -V 2>&1 | grep -q -- '--with-http_sub_module'; then
    echo "nginx with http_sub_module is required" >&2
    exit 1
fi

if [[ -f "$pid_file" ]]; then
    old_pid="$(<"$pid_file")"
    if [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid"
        wait "$old_pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
fi

cat > "$nginx_file" <<EOF
worker_processes 1;
error_log ${log_file} info;
pid /tmp/gopls-web-forward.nginx.pid;

events {
    worker_connections 64;
}

http {
    access_log off;

    server {
        listen 0.0.0.0:${listen_port};

        location / {
            proxy_pass http://127.0.0.1:${target_port};
            proxy_set_header Host 127.0.0.1:${target_port};
            proxy_set_header Accept-Encoding "";

            sub_filter_once off;
            sub_filter_types application/javascript text/javascript text/css;
            sub_filter "http://127.0.0.1:${target_port}" "http://127.0.0.1:${listen_port}";
            sub_filter "http://localhost:${target_port}" "http://127.0.0.1:${listen_port}";
        }
    }
}
EOF

nginx -t -c "$nginx_file" >"$log_file" 2>&1
nginx -c "$nginx_file" -g "daemon off;" >>"$log_file" 2>&1 &
pid="$!"
echo "$pid" > "$pid_file"

sleep 0.2

if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pid_file"
    echo "failed to start nginx; see $log_file" >&2
    exit 1
fi

echo "forwarding and rewriting http://127.0.0.1:${listen_port} -> http://127.0.0.1:${target_port}"
echo "http://127.0.0.1:${listen_port}${path}"
