#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: gopls-web-forward <gopls-url>" >&2
    exit 2
}

[[ "$#" -eq 1 ]] || usage

url="$1"
listen_port=18080
pid_file="/tmp/gopls-web-forward.pid"
log_file="/tmp/gopls-web-forward.log"

case "$url" in
    http://127.0.0.1:*/* | http://localhost:*/*) ;;
    *) usage ;;
esac

without_scheme="${url#http://}"
host_port="${without_scheme%%/*}"
path="/${without_scheme#*/}"
target_port="${host_port##*:}"

if [[ ! "$target_port" =~ ^[0-9]+$ ]]; then
    usage
fi

if [[ "$path" != /gopls/* ]]; then
    usage
fi

if [[ -f "$pid_file" ]]; then
    old_pid="$(<"$pid_file")"
    if [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid"
        wait "$old_pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
fi

socat "TCP-LISTEN:${listen_port},bind=0.0.0.0,reuseaddr,fork" "TCP:127.0.0.1:${target_port}" >"$log_file" 2>&1 &
pid="$!"
echo "$pid" > "$pid_file"

sleep 0.1

if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pid_file"
    echo "failed to start socat; see $log_file" >&2
    exit 1
fi

echo "forwarding http://127.0.0.1:${listen_port} -> http://127.0.0.1:${target_port}"
echo "http://127.0.0.1:${listen_port}${path}"
