# Locale
export LANG=C.UTF-8

# Terminal
export TERM=xterm-ghostty
export COLORTERM=truecolor

# Path
source /root/.nvm/nvm.sh

# Environment
arch=$(dpkg --print-architecture)
export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-${arch}"
[ "$(git config --global --get user.name 2>/dev/null || true)" = "$GIT_USER_NAME" ] || git config --global user.name "$GIT_USER_NAME"
[ "$(git config --global --get user.email 2>/dev/null || true)" = "$GIT_USER_EMAIL" ] || git config --global user.email "$GIT_USER_EMAIL"
export IS_SANDBOX=1
export NODE_ENV=production
export CGO_ENABLED=0
export EDITOR=vim

# Shell Options
shopt -s histappend
shopt -s extglob

# History
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups

# Aliases
alias ls='ls -aF'

# Clipboard (OSC-52)
pbcopy() {
  local b64
  b64=$(base64 | tr -d '\n')
  printf '\033]52;c;%s\a' "$b64" >/dev/tty
}

# Bash Completion
source /usr/share/bash-completion/bash_completion
