[
  // Default Keybinding Removals
  { "key": "cmd+1", "command": "" },
  { "key": "cmd+2", "command": "" },
  { "key": "cmd+3", "command": "" },
  { "key": "cmd+4", "command": "" },
  { "key": "cmd+5", "command": "" },
  { "key": "cmd+6", "command": "" },
  { "key": "cmd+7", "command": "" },
  { "key": "cmd+[", "command": "" },
  { "key": "cmd+]", "command": "" },
  { "key": "cmd+e", "command": "" },
  { "key": "cmd+i", "command": "" },
  { "key": "cmd+l", "command": "" },
  { "key": "cmd+escape", "command": "" },
  { "key": "shift+cmd+g", "command": "" },
  { "key": "alt+escape", "command": "" },

  // Resizing Editor
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "workbench.action.decreaseViewHeight",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "workbench.action.increaseViewHeight",
    "when": "editorTextFocus"
  },

  // Resizing Side Bar
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "sideBarFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "sideBarFocus"
  },

  // Resizing Panel
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "workbench.action.decreaseViewHeight",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "workbench.action.increaseViewHeight",
    "when": "panelFocus"
  },

  //  LLM Code Completion
  {
    "key": "escape",
    "command": "-vscode-neovim.escape"
  },
  {
    "key": "escape",
    "command": "vscode-neovim.escape",
    "when": "editorTextFocus && neovim.init && neovim.mode != 'normal'",
    "args": "<Esc>"
  },
  {
    "key": "escape",
    "command": "vscode-neovim.escape",
    "when": "(!inlineEditIsVisible && !inlineSuggestionVisible) && (editorTextFocus && neovim.init && !dirtyDiffVisible && !findWidgetVisible && !inReferenceSearchEditor && !markersNavigationVisible && !notebookCellFocused && !notificationCenterVisible && !parameterHintsVisible && !referenceSearchVisible && neovim.mode == 'normal')",
    "args": "<Esc>"
  },
  {
    "key": "tab",
    "command": "-vscode-neovim.send"
  },
  {
    "key": "tab",
    "command": "-editor.action.inlineSuggest.commit"
  },
  {
    "key": "tab",
    "command": "vscode-neovim.send",
    "when": "(!inlineEditIsVisible && !inlineSuggestionVisible) && (neovim.init && neovim.recording || editorTextFocus && neovim.init && neovim.mode != 'insert')",
    "args": "<Tab>"
  },
  {
    "key": "tab",
    "command": "editor.action.inlineSuggest.acceptNextLine",
    "when": "editorTextFocus && inlineSuggestionVisible"
  },
  {
    "key": "tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "editorTextFocus && inlineEditIsVisible && tabShouldAcceptInlineEdit"
  },
  {
    "key": "shift+tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "editorTextFocus && (inlineEditIsVisible || inlineSuggestionVisible)"
  },
  {
    "key": "alt+tab",
    "command": "editor.action.inlineSuggest.acceptNextWord",
    "when": "editorTextFocus && (inlineEditIsVisible || inlineSuggestionVisible)"
  },
  {
    "key": "cmd+e",
    "command": "editor.action.inlineSuggest.toggleShowCollapsed",
    "when": "editorTextFocus && (inlineEditIsVisible || inInlineEditsPreviewEditor)"
  },
  {
    "key": "cmd+i",
    "command": "editor.action.inlineSuggest.trigger",
    "when": "editorTextFocus && !inlineEditIsVisible && !inlineSuggestionVisible"
  },
  {
    "key": "cmd+i",
    "command": "editor.action.inlineSuggest.hide",
    "when": "editorTextFocus && (inlineEditIsVisible || inlineSuggestionVisible)"
  },
  {
    "key": "cmd+l",
    "command": "runCommands",
    "args": {
      "commands": [
        {
          "command": "editor.action.inlineSuggest.hide",
          "when": "editorTextFocus && (inlineEditIsVisible || inlineSuggestionVisible)"
        },
        {
          "command": "github.copilot.completions.toggle",
          "when": "editorTextFocus"
        }
      ]
    }
  },

  // Editor Focus
  {
    "key": "cmd+escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus"
  },

  // Left Bar Navigation
  {
    "key": "shift+cmd+g",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "shift+cmd+u",
    "command": "workbench.view.extension.test",
    "when": "workbench.view.testing.active"
  },

  // Right Bar Navigation
  {
    "key": "shift+cmd+c",
    "command": "workbench.action.toggleAuxiliaryBar"
  },

  // Bottom Bar Navigation
  {
    "key": "cmd+1",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "cmd+2",
    "command": "workbench.action.output.toggleOutput",
    "when": "workbench.panel.output.active"
  },
  {
    "key": "cmd+3",
    "command": "workbench.debug.action.toggleRepl",
    "when": "workbench.panel.repl.view.active"
  },
  {
    "key": "cmd+4",
    "command": "workbench.actions.view.problems",
    "when": "workbench.panel.markers.view.active"
  },
  {
    "key": "cmd+5",
    "command": "~remote.forwardedPortsContainer"
  },
  {
    "key": "cmd+6",
    "command": "workbench.panel.testResults.view.focus"
  },

  // Keybinding Passthroughs
  {
    "key": "ctrl+h",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert' || neovim.mode == 'cmdline'",
    "args": "<C-h>"
  },
  {
    "key": "ctrl+j",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert' || neovim.mode == 'cmdline'",
    "args": "<C-j>"
  },
  {
    "key": "ctrl+k",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert' || neovim.mode == 'cmdline'",
    "args": "<C-k>"
  },
  {
    "key": "ctrl+l",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert' || neovim.mode == 'cmdline'",
    "args": "<C-l>"
  },

  // Workaround: https://github.com/vscode-neovim/vscode-neovim/issues/58
  {
    "key": "cmd+j",
    "command": "cursorMove",
    "when": "editorTextFocus && neovim.init && neovim.mode != 'insert'",
    "args": {
      "to": "down",
      "by": "wrappedLine",
      "value": 1
    }
  },
  {
    "key": "cmd+k",
    "command": "cursorMove",
    "when": "editorTextFocus && neovim.init && neovim.mode != 'insert'",
    "args": {
      "to": "up",
      "by": "wrappedLine",
      "value": 1
    }
  },

  // Workaround: https://github.com/vscode-neovim/vscode-neovim/issues/2434
  {
    "key": "ctrl+d",
    "command": "vscode-neovim.send",
    "args": "<C-d>jk", // appending jk centers the cursor when scrolling: https://github.com/vscode-neovim/vscode-neovim/issues/983#issuecomment-1634939702
    "when": "editorTextFocus && neovim.init && neovim.mode == 'visual'"
  },
  {
    "key": "ctrl+u",
    "command": "vscode-neovim.send",
    "args": "<C-u>jk", // appending jk centers the cursor when scrolling: https://github.com/vscode-neovim/vscode-neovim/issues/983#issuecomment-1634939702
    "when": "editorTextFocus && neovim.init && neovim.mode == 'visual'"
  },
  {
    "key": "ctrl+f",
    "command": "vscode-neovim.send",
    "args": "<C-f>zt",
    "when": "editorTextFocus && neovim.init && neovim.mode == 'visual'"
  },
  {
    "key": "ctrl+b",
    "command": "vscode-neovim.send",
    "args": "<C-b>zb",
    "when": "editorTextFocus && neovim.init && neovim.mode == 'visual'"
  },

  // Workaround: https://github.com/vscode-neovim/vscode-neovim/issues/983
  {
    "key": "ctrl+d",
    "command": "runCommands",
    "args": {
      "commands": [
        {
          "command": "editorScroll",
          "args": {
            "to": "down",
            "by": "halfPage"
          }
        },
        {
          "command": "cursorMove",
          "args": {
            "to": "viewPortCenter"
          }
        }
      ]
    },
    "when": "editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+u",
    "command": "runCommands",
    "args": {
      "commands": [
        {
          "command": "editorScroll",
          "args": {
            "to": "up",
            "by": "halfPage"
          }
        },
        {
          "command": "cursorMove",
          "args": {
            "to": "viewPortCenter"
          }
        }
      ]
    },
    "when": "editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+f",
    "command": "runCommands",
    "args": {
      "commands": [
        {
          "command": "editorScroll",
          "args": {
            "to": "down",
            "by": "page"
          }
        },
        {
          "command": "cursorMove",
          "args": {
            "to": "viewPortTop"
          }
        }
      ]
    },
    "when": "editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+b",
    "command": "runCommands",
    "args": {
      "commands": [
        {
          "command": "editorScroll",
          "args": {
            "to": "up",
            "by": "page"
          }
        },
        {
          "command": "cursorMove",
          "args": {
            "to": "viewPortBottom"
          }
        }
      ]
    },
    "when": "editorTextFocus && neovim.init && neovim.mode == 'normal'"
  },

  // Back and Forward Navigation
  {
    "key": "cmd+[",
    "command": "workbench.action.navigateBack",
    "when": "canNavigateBack"
  },
  {
    "key": "cmd+]",
    "command": "workbench.action.navigateForward",
    "when": "canNavigateForward"
  },

  // Leader Actions
  {
    "key": "\\ b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "debuggersAvailable && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ c",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && (neovim.mode == 'normal' || neovim.mode == 'visual')"
  },
  {
    "key": "\\ d",
    "command": "workbench.action.debug.start",
    "when": "debuggersAvailable && debugState == 'inactive' && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ e",
    "command": "editor.action.marker.next",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ f",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ m",
    "command": "gitlens.toggleFileBlame",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ o",
    "command": "editor.action.organizeImports",
    "when": "supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/ && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ r",
    "command": "editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ u",
    "command": "go.toggle.test.file",
    "when": "editorLangId == 'go' && editorTextFocus && neovim.mode == 'normal'"
  },

  {
    "key": "\\ x",
    "command": "editor.action.refactor",
    "when": "editorHasCodeActionsProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ enter",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus && neovim.mode == 'normal'"
  }
]
