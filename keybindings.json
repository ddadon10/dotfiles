[
  // Default Keybinding Removals
  { "key": "cmd+1", "command": "" },
  { "key": "cmd+2", "command": "" },
  { "key": "cmd+3", "command": "" },
  { "key": "cmd+4", "command": "" },
  { "key": "cmd+5", "command": "" },
  { "key": "cmd+6", "command": "" },
  { "key": "cmd+[", "command": "" },
  { "key": "cmd+]", "command": "" },
  { "key": "cmd+escape", "command": "" },
  { "key": "shift+cmd+g", "command": "" },

  // Resizing Editor
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "workbench.action.decreaseViewHeight",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "workbench.action.increaseViewHeight",
    "when": "editorTextFocus"
  },

  // Resizing Side Bar
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "sideBarFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "sideBarFocus"
  },

  // Resizing Panel
  {
    "key": "shift+cmd+left",
    "command": "workbench.action.increaseViewWidth",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+right",
    "command": "workbench.action.decreaseViewWidth",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "workbench.action.decreaseViewHeight",
    "when": "panelFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "workbench.action.increaseViewHeight",
    "when": "panelFocus"
  },

  // LLM Autocomplete
  {
    "key": "alt+space",
    "command": "editor.action.inlineSuggest.trigger",
    "when": "editorTextFocus"
  },

  // Editor Focus
  {
    "key": "cmd+escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus"
  },

  // Left Bar Navigation
  {
    "key": "shift+cmd+g",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "shift+cmd+u",
    "command": "workbench.view.extension.test",
    "when":"workbench.view.testing.active"
  },

  // Right Bar Navigation
  {
    "key": "shift+cmd+c",
    "command": "workbench.action.toggleAuxiliaryBar"
  },

  // Bottom Bar Navigation
  {
    "key": "cmd+1",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "cmd+2",
    "command": "workbench.action.output.toggleOutput",
    "when": "workbench.panel.output.active"
  },
  {
    "key": "cmd+3",
    "command": "workbench.debug.action.toggleRepl",
    "when": "workbench.panel.repl.view.active"
  },
  {
    "key": "cmd+4",
    "command": "workbench.actions.view.problems",
    "when": "workbench.panel.markers.view.active"
  },
  {
    "key": "cmd+5",
    "command": "~remote.forwardedPortsContainer"
  },
  {
    "key": "cmd+6",
    "command": "workbench.view.extension.continueConsole"
  },
  {
    "key": "cmd+7",
    "command": "workbench.panel.testResults.view.focus"
  },

  // Insert and Command Line Mode Navigation
  {
    "key": "ctrl+h",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert'",
    "args": "<Left>"
  },
  {
    "key": "ctrl+j",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert'",
    "args": "<Down>"
  },
  {
    "key": "ctrl+k",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert'",
    "args": "<Up>"
  },
  {
    "key": "ctrl+l",
    "command": "vscode-neovim.send",
    "when": "neovim.init && editorTextFocus && neovim.mode == 'insert'",
    "args": "<Right>"
  },

  // Back and Forward Navigation
  {
    "key": "cmd+[",
    "command": "workbench.action.navigateBack",
    "when": "canNavigateBack"
  },
  {
    "key": "cmd+]",
    "command": "workbench.action.navigateForward",
    "when": "canNavigateForward"
  },

  // GoTo Actions
  {
    "key": "space d",
    "command": "editor.action.revealDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space e",
    "command": "editor.action.marker.nextInFiles",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space h",
    "command": "editor.action.showHover",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space i",
    "command": "editor.action.goToImplementation",
    "when": "editorHasImplementationProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space p",
    "command": "editor.action.peekDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space r",
    "command": "editor.action.goToReferences",
    "when": "editorHasDefinitionProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space s",
    "command": "typescript.goToSourceDefinition",
    "when": "editorLangId == 'typescriptreact' && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space t",
    "command": "editor.action.goToTypeDefinition",
    "when": "editorHasTypeDefinitionProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "space u",
    "command": "go.toggle.test.file",
    "when": "editorLangId == 'go' && editorTextFocus && neovim.mode == 'normal'"
  },

  // Actions
  {
    "key": "\\ enter",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "debuggersAvailable && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ c",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && (neovim.mode == 'normal' || neovim.mode == 'visual')"
  },
  {
    "key": "\\ d",
    "command": "workbench.action.debug.start",
    "when": "debuggersAvailable && debugState == 'inactive' && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ f",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ m",
    "command": "gitlens.toggleFileBlame",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ o",
    "command": "editor.action.organizeImports",
    "when": "supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/ && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ r",
    "command": "editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "\\ x",
    "command": "editor.action.refactor",
    "when": "editorHasCodeActionsProvider && editorTextFocus && neovim.mode == 'normal'"
  }
]
